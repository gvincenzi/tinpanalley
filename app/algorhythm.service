[Unit]
Description=Tin Pan Alley - The Algorhythm
After=network.target

[Service]
User=debian
WorkingDirectory=/home/debian/algorhythm
ExecStart=/usr/bin/java -Xms128m -Xmx512m -jar /home/debian/algorhythm/algorhythm-0.1.0-SNAPSHOT.jar
SuccessExitStatus=143
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target

